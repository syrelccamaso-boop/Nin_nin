            key="signup_last_name"
        )


        # ==========================================
        # EMAIL
        # ==========================================

        signup_email = st.text_input(
            "Email Address",
            placeholder="you@example.com",
            key="signup_email"
        )


        # ==========================================
        # PASSWORD
        # ==========================================

        signup_password = st.text_input(
            "Password",
            type="password",
            placeholder="Create a password",
            key="signup_password"
        )


        # ==========================================
        # CONFIRM PASSWORD
        # ==========================================

        confirm_password = st.text_input(
            "Confirm Password",
            type="password",
            placeholder="Confirm your password",
            key="signup_confirm_password"
        )


        # ==========================================
        # ROLE
        # ==========================================

        role = st.selectbox(
            "Role",
            [
                "Student",
                "Teacher",
                "Admin"
            ],
            key="signup_role"
        )


        # ==========================================
        # SIGN UP BUTTON
        # ==========================================

        signup = st.button(
            "Sign Up",
            width=350,
            key="signup_button"
        )


        # ==========================================
        # SIGN UP PROCESS
        # ==========================================

        if signup:

            # ==========================================
            # GET VALUES
            # ==========================================

            fname = first_name.strip()

            lname = last_name.strip()

            signup_email_value = signup_email.strip()

            password_value = signup_password

            confirm_value = confirm_password


            # ==========================================
            # CHECK FIRST NAME
            # ==========================================

            if not fname:

                show_warning(
                    "Please enter your first name."
                )


            # ==========================================
            # CHECK LAST NAME
            # ==========================================

            elif not lname:

                show_warning(
                    "Please enter your last name."
                )


            # ==========================================
            # CHECK EMAIL
            # ==========================================

            elif not signup_email_value:

                show_warning(
                    "Please enter your email address."
                )


            # ==========================================
            # CHECK PASSWORD
            # ==========================================

            elif not password_value:

                show_warning(
                    "Please enter your password."
                )


            # ==========================================
            # CHECK CONFIRM PASSWORD
            # ==========================================

            elif not confirm_value:

                show_warning(
                    "Please confirm your password."
                )


            # ==========================================
            # VALIDATE EMAIL
            # ==========================================

            elif not re.match(
               r"^[^@\s]+@[^@\s]+\.[^@\s]+$",
                signup_email_value
            ):

                show_warning(
                    "Invalid email address."
                )


            # ==========================================
            # CHECK PASSWORD MATCH
            # ==========================================

            elif password_value != confirm_value:

                show_warning(
                    "Passwords do not match."
                )


            # ==========================================
            # CHECK PASSWORD LENGTH
            # ==========================================

            elif len(password_value) < 6:

                show_warning(
                    "Password must be at least 6 characters."
                )


            # ==========================================
            # CREATE ACCOUNT
            # ==========================================

            else:

                try:

                    # ==========================================
                    # SUPABASE AUTH SIGN UP
                    # ==========================================

                    response = supabase.auth.sign_up(
                        {
                            "email": signup_email_value,
                            "password": password_value,

                            "options": {
                                "data": {
                                    "first_name": fname,
                                    "last_name": lname,
                                    "role": role
                                }
                            }
                        }
                    )


                    # ==========================================
                    # CHECK RESPONSE
                    # ==========================================

                    if response.user:

                        show_success(
                            "Account created successfully!"
                        )


                        # ==========================================
                        # EMAIL CONFIRMATION CHECK
                        # ==========================================

                        if response.session is None:

                            show_info(
                                "Your account was created. "
                                "Please check your email and confirm "
                                "your account before signing in."
                            )

                        else:

                            show_info(
                                "Your account has been registered. "
                                "You can now sign in."
                            )


                        # ==========================================
                        # RETURN TO LOGIN
                        # ==========================================

                        st.session_state.page = "login"

                        st.rerun()


                    else:

                        show_error(
                            "Account was not created."
                        )


                except Exception as e:

                    # ==========================================
                    # SHOW ACTUAL ERROR
                    # ==========================================

                    show_error(
                        "Sign up failed."
                    )

                    st.code(
                        str(e)
                    )


        # ==========================================
        # BACK TO LOGIN
        # ==========================================

        st.markdown(
            """
            <p style="
                text-align:center;
                color:#777;
                margin-top:20px;
            ">
                Already have an account?
            </p>
            """,
            unsafe_allow_html=True
        )


        # ==========================================
        # BACK BUTTON
        # ==========================================

        back_button = st.button(
            "Back to Login",
            width=350,
            key="back_to_login_button"
        )


        if back_button:

            st.session_state.page = "login"

            st.rerun()
