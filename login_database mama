if st.session_state.page == "login":

    with st.container(key="login_card"):

        # ==========================================
        # TITLE
        # ==========================================

        st.markdown(
            """
            <h3 style="
                text-align:center;
                color:#243447;
                margin-bottom:1px;
                font-size:22px;
            ">
                College of Computing Studies,
                Information and Communication Technology
            </h3>

            <p style="
                text-align:center;
                color:#777777;
                font-size:17px;
                margin-bottom:10px;
                margin-top:1px;
            ">
                Computer Monitoring and Management System
            </p>
            """,
            unsafe_allow_html=True
        )


        # ==========================================
        # EMAIL
        # ==========================================

        login_email = st.text_input(
            "Email Address",
            placeholder="you@example.com",
            key="login_email"
        )


        # ==========================================
        # PASSWORD
        # ==========================================

        login_password = st.text_input(
            "Password",
            type="password",
            placeholder="Enter your password",
            key="login_password"
        )


        # ==========================================
        # REMEMBER ME / FORGOT PASSWORD
        # ==========================================

        col1, col2 = st.columns([1, 1])

        with col1:

            remember_me = st.checkbox(
                "Remember Me",
                key="remember_me"
            )

        with col2:

            st.markdown(
                """
                <div style="
                    text-align:right;
                    margin-top:5px;
                ">
                    <span style="color:#3974a8;">
                        Forgot password?
                    </span>
                </div>
                """,
                unsafe_allow_html=True
            )


        # ==========================================
        # SIGN IN BUTTON
        # ==========================================

        login = st.button(
            "Sign In",
            width=350,
            key="login_button"
        )


        # ==========================================
        # LOGIN PROCESS
        # ==========================================

        if login:

            login_email_value = login_email.strip()

            # ==========================================
            # CHECK EMPTY FIELDS
            # ==========================================

            if not login_email_value:

                show_warning(
                    "Please enter your email address."
                )

            elif not login_password:

                show_warning(
                    "Please enter your password."
                )


            # ==========================================
            # CHECK EMAIL
            # ==========================================

            elif not re.match(
                r"^[^@\s]+@[^@\s]+\.[^@\s]+$",
                login_email_value
            ):

                show_warning(
                    "Invalid email address."
                )


            # ==========================================
            # SUPABASE LOGIN
            # ==========================================

            else:

                try:

                    response = supabase.auth.sign_in_with_password(
                        {
                            "email": login_email_value,
                            "password": login_password
                        }
                    )


                    # ==========================================
                    # CHECK AUTH USER
                    # ==========================================

                    if response.user:

                        user_id = response.user.id


                        # ==========================================
                        # GET USER PROFILE
                        # ==========================================

                        user_data = (
                            supabase
                            .table("Users")
                            .select("*")
                            .eq("AuthId", user_id)
                            .execute()
                        )


                        # ==========================================
                        # USER PROFILE FOUND
                        # ==========================================

                        if user_data.data:

                            user = user_data.data[0]

                            first_name = user.get(
                                "FirstName",
                                ""
                            )

                            last_name = user.get(
                                "LastName",
                                ""
                            )

                            role = user.get(
                                "Role",
                                "Student"
                            )


                            # ==========================================
                            # SUCCESS
                            # ==========================================

                            show_success(
                                "Login successful!"
                            )

                            st.write(
                                f"Welcome, {first_name} {last_name}!"
                            )

                            st.write(
                                f"Role: {role}"
                            )


                            if remember_me:

                                show_info(
                                    "Your login will be remembered."
                                )


                        # ==========================================
                        # PROFILE NOT FOUND
                        # ==========================================

                        else:

                            show_warning(
                                "Authentication successful, "
                                "but your user profile was not found."
                            )

                            show_info(
                                "Please check your Users table "
                                "and Supabase trigger."
                            )


                    # ==========================================
                    # AUTH USER NOT FOUND
                    # ==========================================

                    else:

                        show_error(
                            "Login failed. User was not found."
                        )


                except Exception as e:

                    show_error(
                        "Login failed."
                    )

                    st.code(
                        str(e)
                    )


        # ==========================================
        # CREATE ACCOUNT TEXT
        # ==========================================

        st.markdown(
            """
            <p style="
                text-align:center;
                color:#777;
                margin-top:20px;
            ">
                Don't have an account?
            </p>
            """,
            unsafe_allow_html=True
        )


        # ==========================================
        # CREATE ACCOUNT BUTTON
        # ==========================================

        signup_button = st.button(
            "Create an Account",
            width=350,
            key="create_account_button"
        )


        if signup_button:

            st.session_state.page = "signup"

            st.rerun()


